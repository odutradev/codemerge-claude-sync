{
  "projectName": "codemerge-claude-sync",
  "outputPath": "codemerge-claude-sync-merged.txt",
  "watch": false,
  "onUpsertCommand":"npm run build",
  "useGitignore": true,
  "ignorePatterns": [
    "node_modules/**",
    ".git/**",
    "dist/**",
    "build/**",
    "**/*.log",
    ".env*",
    "**/.DS_Store",
    "coverage/**",
    ".next/**",
    ".nuxt/**"
  ],
  "includePatterns": [
    "**/*.ts",
    "**/*.js",
    "**/*.tsx",
    "**/*.jsx",
    "**/*.json",
    "**/*.md"
  ]
}
